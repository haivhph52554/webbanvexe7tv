<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Chi tiết đặt chỗ</title>

  <style>
    *{box-sizing:border-box}
    body{
      font-family: Inter, Segoe UI, Arial, sans-serif;
      background:#eef2ff;
      color:#0f172a;
      margin:0;
    }

    /* ===== CONTAINER ===== */
    .container{
      width:calc(100% - 48px);
      margin:24px;
      background:#ffffff;
      border-radius:18px;
      box-shadow:0 20px 40px rgba(30,41,59,.15);
      overflow:hidden;
    }

    /* ===== HEADER ===== */
    .header{
      padding:28px 32px;
      display:flex;
      justify-content:space-between;
      align-items:center;
      background:linear-gradient(135deg,#6366f1,#8b5cf6);
      color:white;
    }

    .header h2{
      margin:0;
      font-size:24px;
      font-weight:700;
    }

    .sub{
      margin-top:6px;
      font-size:13px;
      opacity:.9;
    }

    .badge{
      padding:6px 16px;
      border-radius:999px;
      font-size:13px;
      font-weight:700;
      background:#22c55e;
      color:white;
      text-transform:capitalize;
    }

    /* ===== CONTENT ===== */
    .content{
      padding:32px;
      background:#f8fafc;
    }

    .section{
      margin-bottom:32px;
      background:#ffffff;
      border-radius:16px;
      border:1px solid #e5e7eb;
      padding:20px 22px;
      box-shadow:0 10px 24px rgba(15,23,42,.05);
    }

    .section-title{
      font-size:13px;
      font-weight:700;
      color:#4f46e5;
      margin-bottom:16px;
      text-transform:uppercase;
      letter-spacing:.05em;
    }

    .grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
      gap:18px;
    }

    .item{
      background:#f9fafb;
      border-radius:12px;
      padding:16px 18px;
      border-left:5px solid #6366f1;
    }

    .label{
      font-size:12px;
      color:#64748b;
      margin-bottom:6px;
    }

    .value{
      font-size:15px;
      font-weight:700;
      color:#0f172a;
      word-break:break-word;
    }

    .note{
      background:#f1f5ff;
      border:2px dashed #6366f1;
      border-radius:12px;
      padding:16px;
      color:#1e293b;
      font-weight:500;
      min-height:60px;
    }

    /* ===== FOOTER ===== */
    .actions{
      padding:20px 32px;
      background:#f1f5f9;
      border-top:1px solid #e5e7eb;
      display:flex;
      justify-content:flex-end;
      gap:12px;
    }

    .btn{
      padding:10px 18px;
      border-radius:12px;
      font-size:14px;
      font-weight:700;
      text-decoration:none;
      background:#e5e7eb;
      color:#0f172a;
      transition:.2s;
    }

    .btn:hover{opacity:.85}

    .btn-primary{
      background:linear-gradient(135deg,#6366f1,#4f46e5);
      color:white;
    }

    /* ===== RESPONSIVE ===== */
    @media(max-width:768px){
      .container{
        width:100%;
        margin:0;
        border-radius:0;
      }

      .content{
        padding:20px;
      }

      .header{
        flex-direction:column;
        align-items:flex-start;
        gap:12px;
      }

      .actions{
        flex-direction:column;
      }
    }
  </style>
</head>

<body>

<div class="container">

  <!-- HEADER -->
  <div class="header">
    <div>
      <h2>Chi tiết đặt chỗ</h2>
      <div class="sub">Mã vé: <strong><%= booking._id %></strong></div>
    </div>
    <span class="badge"><%= booking.status %></span>
  </div>

  <!-- CONTENT -->
  <div class="content">

    <div class="section">
      <div class="section-title">Thông tin hành khách</div>
      <div class="grid">
        <div class="item">
          <div class="label">Hành khách</div>
          <div class="value">
            <%= booking.user?.full_name || booking.passenger?.name || 'Không có' %>
          </div>
        </div>
        <div class="item">
          <div class="label">Số điện thoại</div>
          <div class="value">
            <%= booking.user?.phone || booking.passenger?.phone || 'Không có' %>
          </div>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="section-title">Thông tin vé</div>
      <div class="grid">
        <div class="item">
          <div class="label">Ghế</div>
          <div class="value"><%= booking.seat_numbers?.join(', ') || 'Không có' %></div>
        </div>
        <div class="item">
          <div class="label">Tổng tiền</div>
          <div class="value">
            <%= ((booking.total_price||booking.total_amount)||0).toLocaleString('vi-VN') %> ₫
          </div>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="section-title">Thông tin chuyến</div>
      <div class="grid">
        <div class="item">
          <div class="label">Chuyến</div>
          <div class="value">
            <%= booking.trip?.route?.name || 'Không có' %>
          </div>
        </div>
        <div class="item">
          <div class="label">Biển số xe</div>
          <div class="value">
            <%= booking.trip?.bus?.license_plate || 'Không có' %>
          </div>
        </div>
        <div class="item">
          <div class="label">Tài xế</div>
          <div class="value">
            <%= booking.driver_snapshot?.name || 'Không có' %>
          </div>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="section-title">Thời gian</div>
      <div class="grid">
        <div class="item">
          <div class="label">Ngày khởi hành</div>
          <div class="value"><%= new Date(booking.start_time).toLocaleString('vi-VN') %></div>
        </div>
        <div class="item">
          <div class="label">Ngày đặt</div>
          <div class="value"><%= new Date(booking.createdAt).toLocaleString('vi-VN') %></div>
        </div>
      </div>
    </div>

    <div class="section">
      <div class="section-title">Ghi chú hành khách</div>
      <div class="note">
        <%= booking.passenger?.note || '-' %>
      </div>
    </div>

  </div>

  <!-- ACTIONS -->
  <div class="actions">
    <a href="/admin/bookings" class="btn">← Quay lại</a>
    <a href="/admin/bookings/<%= booking._id %>/edit" class="btn btn-primary">Chỉnh sửa</a>
  </div>

</div>

</body>
</html>
